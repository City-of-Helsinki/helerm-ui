{
  "name": "helerm-ui",
  "version": "1.11.0",
  "description": "UI for Helsinki Electronic Records Management Classification System",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/City-of-Helsinki/helerm-ui.git"
  },
  "author": "City of Helsinki",
  "license": "MIT",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.1.3"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "^6.3.0",
    "@nabla/vite-plugin-eslint": "^3.0.1",
    "@reduxjs/toolkit": "^2.8.2",
    "@sentry/react": "^10.19.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.1",
    "bootstrap-sass": "^3.4.1",
    "classnames": "^2.3.2",
    "date-fns": "^2.29.3",
    "dompurify": "^3.4.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-vitest-globals": "^2.0.2",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-sonarjs": "^4.0.2",
    "esrun": "^3.2.30",
    "exceljs": "^4.4.0",
    "globals": "^17.4.0",
    "hds-core": "^6.0.2",
    "hds-design-tokens": "^6.0.2",
    "hds-react": "^6.0.2",
    "lodash": "^4.18.1",
    "normalizr": "^3.6.2",
    "prettier": "^2.8.4",
    "prop-types": "^15.8.1",
    "react": "^19.2.5",
    "react-datepicker": "^4.25.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.30.3",
    "react-select": "^5.8.1",
    "react-sticky-el": "^2.1.1",
    "remark-gfm": "^4.0.1",
    "sass": "^1.79.4",
    "vite": "^8.0.16",
    "vitest": "^4.1.2"
  },
  "scripts": {
    "app:version": "echo \"$npm_package_version\"",
    "start": "pnpm update-runtime-env && vite",
    "build": "vite build",
    "serve": "vite preview",
    "test": "NODE_ENV=test pnpm update-runtime-env && vitest",
    "test:coverage": "pnpm test run --coverage --watch=false",
    "lint": "pnpm eslint \"src/**/*.{js,jsx}\"",
    "postinstall": "if test \"$NODE_ENV\" != \"production\" ; then husky install ; fi",
    "test:e2e:install": "npx playwright install",
    "test:e2e:ci": "npx playwright test",
    "test:e2e:start": "npx playwright test",
    "test:e2e:record": "npx playwright codegen https://tiedonohjaus.dev.hel.ninja/",
    "update-runtime-env": "esrun scripts/update-runtime-env.js"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "ie 11"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version",
      "ie 11"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^24.12.2",
    "@vitest/coverage-istanbul": "^4.1.2",
    "fake-indexeddb": "^6.2.4",
    "husky": "^8.0.3",
    "jsdom": "^29.0.1",
    "shadow-dom-testing-library": "^1.13.1"
  }
}
